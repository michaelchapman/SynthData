{
  "defaults": {
    "missing": 0.01
  },
  "resources": {
    "person": {
      "rowCount": 500,
      "fields": {
        "year_of_birth": {
          "distribution": "normal",
          "mean": 1962,
          "sd": 20
        }
      }
    },
    "visit_occurrence": {
      "childrenPerParent": {
        "distribution": "poisson",
        "mean": 4
      },
      "fields": {
        "visit_concept_id": {
          "distribution": "weights",
          "weights": {
            "9201": 1,
            "9202": 7,
            "9203": 2
          }
        }
      },
      "rules": [
        {
          "type": "offset",
          "field": "visit_end_date",
          "reference": "visit_start_date",
          "when": {
            "visit_concept_id": 9201
          },
          "offset": {
            "distribution": "exponential",
            "mean": 5,
            "min": 1,
            "max": 60
          }
        },
        {
          "type": "offset",
          "field": "visit_end_date",
          "reference": "visit_start_date",
          "when": {
            "visit_concept_id": 9202
          },
          "offset": {
            "distribution": "constant",
            "value": 0
          }
        },
        {
          "type": "offset",
          "field": "visit_end_date",
          "reference": "visit_start_date",
          "when": {
            "visit_concept_id": 9203
          },
          "offset": {
            "distribution": "weights",
            "weights": {
              "0": 3,
              "1": 1
            }
          }
        }
      ]
    },
    "condition_occurrence": {
      "childrenPerParent": {
        "distribution": "poisson",
        "mean": 1.3
      },
      "fields": {
